# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# ── OpenAI Copilot (required for LLM-powered /explain answers) ──────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Model used by the copilot. gpt-4o-mini is the default (fast, cheap).
# Other options: gpt-4o, gpt-4-turbo
OPENAI_COPILOT_MODEL=gpt-4o-mini

# ── Kaggle (required only for scripts/download_data.py) ─────────────────────
# Get your API key at https://www.kaggle.com/settings → API → Create New Token
# Alternatively, place {"username":…,"key":…} in ~/.kaggle/kaggle.json
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key

# ── Alert notifications ──────────────────────────────────────────────────────
# Enable channels in config/base/default.yaml (monitoring.alerts.channels).

# Slack — post to an Incoming Webhook URL
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Email via SMTP (e.g. Gmail, SendGrid, SES SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-smtp-app-password
# ALERT_EMAIL_FROM=alerts@example.com
# ALERT_EMAIL_TO=oncall@example.com

# PagerDuty — Events API v2 integration key
# PAGERDUTY_INTEGRATION_KEY=your-integration-key

# ── Optional path overrides (leave blank to use project-root defaults) ───────
# E2E_PROJECT_ROOT=
# E2E_PROCESSED_PARQUET_PATH=
# E2E_MODEL_ARTIFACTS_DIR=
# E2E_MONITORING_STATE_JSON=
# APP_ENV=local

# Local terraform.tfvars contains secrets — never commit
terraform.tfvars
*.tfvars
!terraform.tfvars.example

# Terraform state — use remote backend (GCS), never commit local state
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform working directories
.terraform/
.terraform.lock.hcl

# Plan output files
tfplan
*.tfplan

# Crash log files
crash.log
crash.*.log

# Override files (local developer overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json
